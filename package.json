{
  "name": "@isaac545454/frontend-events",
  "version": "0.1.0",
  "description": "Barramento de eventos tipado. O projeto consumidor declara os nomes e os payloads.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
